<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>FrontsAndRivals</AssemblyName>
    <RootNamespace>FrontsAndRivals</RootNamespace>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>3.1.0</Version>
    <!-- Keep SHVDN/LemonUI/iFruitAddon2 DLLs out of bin: players install them, we never ship them. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="ScriptHookVDotNet3" Version="3.6.0" />
    <PackageReference Include="LemonUI.SHVDN3" Version="2.2.0" />
    <PackageReference Include="iFruitAddon2" Version="3.1.1" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
  <ItemGroup>
    <None Include="FrontsAndRivals.ini" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Content\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Deploy: copies only our own files (dll, pdb for line numbers in the log, ini) into <GtaVDir>\scripts.
    GtaVDir comes from the git-ignored Directory.Build.props.user. Never copies game files or other mods' DLLs.
  -->
  <Target Name="DeployToGta" AfterTargets="Build" Condition="'$(GtaVDir)' != ''">
    <Error Condition="!Exists('$(GtaVDir)')" Text="GtaVDir does not exist: $(GtaVDir). Fix it in Directory.Build.props.user." />
    <MakeDir Directories="$(GtaVDir)\scripts" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb"
          DestinationFolder="$(GtaVDir)\scripts" SkipUnchangedFiles="true" />
    <!-- The INI is copied only if there isn't one yet, so your in-game settings (DevTools=true etc.) survive rebuilds. -->
    <Copy SourceFiles="$(TargetDir)FrontsAndRivals.ini" DestinationFolder="$(GtaVDir)\scripts"
          Condition="!Exists('$(GtaVDir)\scripts\FrontsAndRivals.ini')" />
    <!-- Content: names/models always update; fronts.json only if missing, because in-game scouting writes it. -->
    <MakeDir Directories="$(GtaVDir)\scripts\FrontsAndRivals" />
    <Copy SourceFiles="$(TargetDir)Content\names.json;$(TargetDir)Content\models.json;$(TargetDir)Content\crews.json;$(TargetDir)Content\lines.json"
          DestinationFolder="$(GtaVDir)\scripts\FrontsAndRivals" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)Content\fronts.json" DestinationFolder="$(GtaVDir)\scripts\FrontsAndRivals"
          Condition="!Exists('$(GtaVDir)\scripts\FrontsAndRivals\fronts.json')" />
    <Message Importance="high" Text="Deployed FrontsAndRivals to $(GtaVDir)\scripts" />
  </Target>
</Project>
